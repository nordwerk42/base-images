FROM golang:1.27@sha256:5f1b98fa02fe396ebce2a0227a0e08309e11792915b9dd2e1f71053d7e7e6666 AS builder
WORKDIR /app
COPY . .
RUN go build -o myapp


FROM registry.opencode.de/open-code/oci/base:latest

COPY --from=builder --chown=53111:53111 /app/myapp /myapp

USER 53111

CMD [ "/myapp" ]