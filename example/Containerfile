FROM golang:1.27@sha256:205c7636d74e0ffbe3d007162df7d74f859f5a8c8322dfb9f907977686c126cf AS builder
WORKDIR /app
COPY . .
RUN go build -o myapp


FROM registry.opencode.de/open-code/oci/base:latest

COPY --from=builder --chown=53111:53111 /app/myapp /myapp

USER 53111

CMD [ "/myapp" ]