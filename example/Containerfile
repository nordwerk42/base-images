FROM golang:1.25 AS builder
WORKDIR /app
COPY . .
RUN go build -o myapp


FROM registry.opencode.de/open-code/oci/base:latest

COPY --from=builder --chown=53111:53111 /app/myapp /myapp

USER 53111

CMD [ "/myapp" ]